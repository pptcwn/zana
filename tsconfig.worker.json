{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./lib",
    "outDir": "./dist",
    "noEmit": false,
    "incremental": false,
    "declaration": false,
    "sourceMap": true,
    "isolatedModules": false
  },
  "include": [
    "lib/jobs/worker.ts",
    "lib/jobs/queues.ts",
    "lib/jobs/handlers/**/*.ts",
    "lib/notifications/telegram.ts",
    "lib/platforms/types.ts",
    "lib/supabase/types.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
